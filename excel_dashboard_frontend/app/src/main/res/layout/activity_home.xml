<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_background"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/homeRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:id="@+id/homeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/appLogo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/home_logo_cd"
                android:src="@drawable/ic_logo_placeholder" />

            <TextView
                android:id="@+id/homeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/home_title"
                android:textColor="@color/vd_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_subtitle"
                android:textColor="@color/vd_text_muted"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/homeIllustration"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/home_illustration_cd"
                android:scaleType="centerInside"
                android:src="@drawable/ic_home_illustration" />

            <Button
                android:id="@+id/btnGetStarted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_primary"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="@string/home_get_started"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/homeFootnote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/home_privacy_note"
                android:textColor="@color/vd_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
