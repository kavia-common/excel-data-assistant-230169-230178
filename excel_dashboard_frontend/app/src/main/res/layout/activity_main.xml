<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_background"
    android:orientation="horizontal"
    tools:context=".MainActivity">

    <!-- LEFT: Main workspace -->
    <LinearLayout
        android:id="@+id/mainWorkspace"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Upload card -->
        <LinearLayout
            android:id="@+id/uploadCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_dashboard"
                android:textColor="@color/vd_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/subtitle_upload"
                android:textColor="@color/vd_text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickFiles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_primary"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="@string/action_pick_xlsx"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/uploadStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/status_no_file"
                    android:textColor="@color/vd_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sheet selector row -->
        <LinearLayout
            android:id="@+id/sheetRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_sheet"
                android:textColor="@color/vd_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/sheetSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:padding="10dp" />
        </LinearLayout>

        <!-- Spreadsheet card -->
        <LinearLayout
            android:id="@+id/gridCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/gridHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hint_grid"
                android:textColor="@color/vd_text_muted"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    android:paddingTop="4dp" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- RIGHT: Prompt / command panel -->
    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:background="@color/vd_surface"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/promptTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_prompt"
            android:textColor="@color/vd_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/promptHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/prompt_help"
            android:textColor="@color/vd_text_muted"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:padding="10dp">

            <TextView
                android:id="@+id/promptLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/log_ready"
                android:textColor="@color/vd_text"
                android:textSize="12sp" />
        </ScrollView>

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_command"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/vd_text"
            android:textColorHint="@color/vd_text_muted" />

        <Button
            android:id="@+id/btnRunCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/action_run"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>
